APP_NAME="Anteraja Pharma"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8170
APP_LOCALE=id
FRONTEND_URL=http://localhost:3170

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=anteraja_pharma_hackathon
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=file
SESSION_COOKIE=pharma_session
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database
LOG_CHANNEL=stack

# setup generates local demo credentials; never copy a production password here.
DEMO_PASSWORD=
# required for externally triggered automation and Telegram webhooks.
AUTOMATION_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=

# server-only Telegram settings. All test recipients must /start the bot first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_COURIER_CHAT_ID=
TELEGRAM_BUYER_CHAT_ID=
TELEGRAM_CHECKER_CHAT_ID=
TELEGRAM_SENDER_CHAT_ID=

# Optional AI-assisted incident summaries. Never expose these values to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
